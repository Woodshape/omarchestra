+    stdout: StdioCollector {
+      id: validationStdout
+      waitForEnd: true
+    }
+    stderr: StdioCollector {
+      id: validationStderr
+      waitForEnd: true
+    }
+    onExited: function(exitCode) { root.validationFinished(root.processWorkSerial, exitCode) }
+  }
