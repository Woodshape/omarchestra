+  property Timer validationTimeout: Timer {
+    interval: 5000
+    repeat: false
+    onTriggered: root.validationTimedOut()
+  }
+
+  property Timer tombstoneTimer: Timer {
+    interval: 60000
+    repeat: true
+    running: true
