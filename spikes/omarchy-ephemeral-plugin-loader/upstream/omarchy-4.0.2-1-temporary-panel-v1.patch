+// Candidate-only host for omarchy.temporary-panel/v1. This module keeps
+// temporary registrations out of PluginRegistry and shell.json. It is
+// intentionally a trusted same-user source interface, not a sandbox.
+QtObject {
+  id: root
+
+  property var shell: null
+  property var pluginRegistry: null
+  property var barWidgetRegistry: null
+  property string omarchyPath: ""
+  readonly property string instanceNonce: String(Quickshell.instanceId || "shell")
