+    delete pendingByRequest[operation.requestJson]
+    root.pruneOperations()
+  }
+
+  function recordFor(id) {
+    var resolved = resolveRegistration(id)
+    if (resolved.error) return resolved
+    return resolved
+  }
+
+  function injectItem(item, manifest) {
+    if (!item) return
+    if ("omarchyPath" in item) item.omarchyPath = root.omarchyPath
+    if ("shell" in item) item.shell = root.shell
+    if ("manifest" in item) item.manifest = manifest
+    if ("barWidgetRegistry" in item) item.barWidgetRegistry = root.barWidgetRegistry
+    if ("pluginRegistry" in item) item.pluginRegistry = root.pluginRegistry
+    // A temporary panel is routed by the host. Disable the base Panel IPC
+    // target when the component exposes these optional properties.
+    if ("manageIpc" in item) item.manageIpc = false
+    if ("ipcTarget" in item) item.ipcTarget = ""
+  }
+
+  function handleLoaded(registrationId, generation, loader, item) {
+    var record = registrations[registrationId]
+    if (!record || record.loader !== loader || record.generation !== generation
+        || record.state !== "loading" || !record.opened) return
+    if (!item) {
+      failLoading(registrationId, generation, "plugin_load_failed", "Loader resolved without an item")
+      return
+    }
+    record.item = item
+    injectItem(item, record.manifest)
+    drainQueue(record)
+    if (record.state === "loading" && record.opened) record.state = "summoned"
+  }
+
+  function handleItemChanged(registrationId, generation, loader, item) {
+    var record = registrations[registrationId]
+    if (!record || record.loader !== loader || record.generation !== generation) return
+    if (item && (record.state === "loading" || record.state === "summoned")) record.item = item
+    else if (!item) record.item = null
+  }
+
+  function handleLoadError(registrationId, generation, loader, detail) {
+    var record = registrations[registrationId]
+    if (!record || record.loader !== loader || record.generation !== generation) return
+    failLoading(registrationId, generation, "plugin_load_failed", detail || "temporary panel failed to load")
+  }
+
+  function failLoading(registrationId, generation, code, message) {
+    var record = registrations[registrationId]
+    if (!record || record.generation !== generation
+        || (record.state !== "loading" && record.state !== "summoned")) return
+    record.lastError = truncate(message || code, limits.diagnosticsBytes)
+    record.state = "failed"
+    record.opened = false
+    record.queue = []
+    record.generation++
+    var loader = record.loader
+    if (loader) {
+      loader.callbackGeneration = record.generation
+      loader.active = false
+      loader.source = ""
+      loader.destroy()
+    }
+    record.item = null
+  }
+
+  function drainQueue(record) {
+    var queue = record.queue
+    record.queue = []
+    for (var i = 0; i < queue.length; i++) {
+      if (!record.item) return
+      var entry = queue[i]
+      try {
+        if (entry.kind === "open") {
+          if (typeof record.item.open !== "function") throw new Error("open method is missing")
+          record.item.open(entry.payloadJson)
+        } else {
+          if (typeof record.item[entry.method] !== "function") throw new Error("method is missing")
+          record.item[entry.method](entry.payloadJson)
+        }
+      } catch (e) {
+        record.lastError = truncate("plugin delivery failed: " + (e && e.message ? e.message : "threw"), limits.diagnosticsBytes)
+      }
+    }
+  }
+
+  function queuedBytes(record) {
+    var total = 0
+    for (var i = 0; i < record.queue.length; i++) total += record.queue[i].bytes
+    return total
+  }
+
+  function enqueue(record, entry) {
+    if (record.queue.length >= limits.queuedCallsPerRegistration) return false
+    if (queuedBytes(record) + entry.bytes > limits.queuedBytesPerRegistration) return false
+    record.queue.push(entry)
+    return true
+  }
+
+  function activateLoading(registrationId, generation) {
+    var record = registrations[registrationId]
+    if (!record || record.state !== "loading" || record.generation !== generation || !record.opened
+        || record.loader) return
+    var loader = temporaryPanelLoaderComponent.createObject(root, {
+      registrationId: registrationId,
+      callbackGeneration: generation
+    })
+    if (!loader) {
+      failLoading(registrationId, generation, "plugin_load_failed", "Loader could not be created")
+      return
+    }
+    record.loader = loader
+    loader.source = record.sourceUrl
+    loader.active = true
+  }
+
+  function closeItem(record) {
+    if (!record.item || typeof record.item.close !== "function") return
+    try { record.item.close() } catch (e) {
+      record.lastError = truncate("close() threw during teardown", limits.diagnosticsBytes)
+    }
+  }
+
+  function releaseClaims(record) {
+    if (record && sourceClaims[record.canonicalPath] === record.registrationId)
+      delete sourceClaims[record.canonicalPath]
+    if (record && pluginIdClaims[record.pluginId] === record.registrationId)
+      delete pluginIdClaims[record.pluginId]
+  }
+
+  function beginCollisionFailure(record) {
+    if (!record || record.state === "unregistered" || record.state === "unregistering") return
+    record.state = "failed_collision"
+    record.lastError = "installed registry change collided with this temporary registration"
+    record.opened = false
+    record.queue = []
+    record.generation++
+    closeItem(record)
+    var loader = record.loader
+    if (loader) {
+      loader.callbackGeneration = record.generation
+      loader.active = false
+      loader.source = ""
+      loader.destroy()
+    }
+    record.item = null
+  }
+
+  function recheckCollisions() {
+    var installed = pluginRegistry && pluginRegistry.installedPlugins ? pluginRegistry.installedPlugins : ({})
+    for (var id in registrations) {
+      var record = registrations[id]
+      if (!record || record.state === "unregistered" || record.state === "unregistering"
+          || record.state === "failed_collision") continue
+      var idCollision = hasKey(installed, record.pluginId)
+      var sourceCollision = false
+      for (var installedId in installed) {
+        var manifest = installed[installedId]
+        var source = manifest && typeof manifest.__sourceDir === "string"
+          ? manifest.__sourceDir.replace(/\/$/, "") : ""
+        if (source && source === record.canonicalPath) { sourceCollision = true; break }
+      }
+      if (idCollision || sourceCollision) root.beginCollisionFailure(record)
+    }
+  }
+
+  function beginUnregister(record) {
+    if (!record || record.state === "unregistered" || record.state === "unregistering") return
+    record.state = "unregistering"
+    record.opened = false
+    record.queue = []
+    record.generation++
+    closeItem(record)
+    var loader = record.loader
+    if (loader) {
+      loader.callbackGeneration = record.generation
+      loader.active = false
+      loader.source = ""
+      loader.destroy()
+    } else {
+      finalizeUnregister(record)
+    }
+  }
+
+  function finalizeUnregister(record) {
+    if (!record || record.state !== "unregistering" || record.loader || record.item) return
+    releaseClaims(record)
+    record.state = "unregistered"
+    record.opened = false
+    record.queue = []
+    record.tombstoneExpiresAt = Date.now() + limits.tombstoneMs
+    pruneTombstones()
+  }
+
+  function handleLoaderDestroyed(registrationId, generation, loader) {
+    var record = registrations[registrationId]
+    if (!record || record.loader !== loader || record.generation !== generation) return
+    record.item = null
+    record.loader = null
+    if (record.state === "unregistering") finalizeUnregister(record)
+    else if (record.state === "hiding") {
+      record.state = "registered_hidden"
+      record.opened = false
+    }
+  }
+
+  function dispatchCapabilities() {
+    return success("capabilities", {
+      interface: "omarchy.temporary-panel/v1",
+      supported: true,
+      scope: ["panel"],
+      registration: "asynchronous",
+      persistence: "process-memory-only",
+      restart: "registrations-cleared",
+      limits: limits
+    })
+  }
+
+  function dispatchRegister(body, requestJson) {
+    var rawPath = body.path
+    var pathError = sourceSyntaxError(rawPath)
+    if (pathError) return failure("register", pathError, "path must be absolute, bounded, and free of NUL/newline")
+    if (pluginRegistry && pluginRegistry.scanning)
+      return failure("register", "registry_busy", "installed registry scan is unresolved")
+    if (hasKey(pendingByRequest, requestJson))
+      return failure("register", "duplicate_pending", "an identical registration is already validating")
+    if (countRegistrationSlots() >= limits.registrations)
+      return failure("register", "capacity_exceeded", "registration capacity is full")
+    var operationId = beginOperation(rawPath, requestJson)
+    if (!operationId) return failure("register", "capacity_exceeded", "operation identity could not be allocated")
+    return success("register", { state: "validating", operationId: operationId })
+  }
+
+  function dispatchStatus(body) {
+    var operationId = body.operationId
+    if (typeof operationId !== "string" || operationId.length === 0
+        || utf8Bytes(operationId) > limits.identityBytes || operationId.indexOf("op.") !== 0)
+      return failure("status", "invalid_identity", "operationId is malformed")
+    var operation = operations[operationId]
+    if (!operation) return failure("status", "unknown_operation_id", "operation is absent or expired")
+    if (operation.state === "validating") return success("status", { state: "validating" })
+    if (operation.state === "rejected") return success("status", {
+      state: "rejected",
+      error: { code: operation.error.code, message: operation.error.message }
+    })
+    return success("status", {
+      state: "registered_hidden",
+      registrationId: operation.registrationId,
+      pluginId: operation.pluginId
+    })
+  }
+
+  function dispatchSummon(body) {
+    var resolved = recordFor(body.registrationId)
+    if (resolved.error) return failure("summon", resolved.error, resolved.error)
+    if (resolved.tombstone) return failure("summon", "unknown_registration", "registration is unregistered")
+    var record = resolved.record
+    if (record.state === "unregistering" || record.state === "hiding")
+      return failure("summon", "teardown_pending", "registration teardown is pending")
+    if (record.state === "failed" || record.state === "failed_collision")
+      return failure("summon", "plugin_load_failed", record.lastError || "registration failed")
+    var payloadJson = serializePayload(body.payload)
+    if (!payloadJson) return failure("summon", "invalid_payload", "payload is invalid or exceeds its bounds")
+    var entry = { kind: "open", payloadJson: payloadJson, bytes: utf8Bytes(payloadJson) }
+    if (!enqueue(record, entry)) return failure("summon", "queue_full", "registration queue bound reached")
+    if (record.state === "registered_hidden") {
+      record.opened = true
+      record.state = "loading"
+      record.generation++
+      enqueueValidation({
+        kind: "load",
+        phase: "load",
+        registrationId: record.registrationId,
+        generation: record.generation,
+        path: record.canonicalPath,
+        entry: record.manifest.entryPoints.panel
+      })
+    }
+    if (record.item) drainQueue(record)
+    return success("summon", { state: record.state, queued: record.queue.length })
+  }
+
+  function dispatchCall(body) {
+    var resolved = recordFor(body.registrationId)
+    if (resolved.error) return failure("call", resolved.error, resolved.error)
+    if (resolved.tombstone) return failure("call", "unknown_registration", "registration is unregistered")
+    var record = resolved.record
+    if (record.state === "unregistering" || record.state === "hiding")
+      return failure("call", "teardown_pending", "registration teardown is pending")
+    if (record.state !== "loading" && record.state !== "summoned")
+      return failure("call", "not_summoned", "call requires an active summon")
+    if (!validMethod(body.method)) return failure("call", "invalid_method", "method violates the call rules")
+    var payloadJson = serializePayload(body.payload)
+    if (!payloadJson) return failure("call", "invalid_payload", "payload is invalid or exceeds its bounds")
+    if (record.state === "loading") {
+      var entry = { kind: "call", method: body.method, payloadJson: payloadJson, bytes: utf8Bytes(payloadJson) }
+      if (!enqueue(record, entry)) return failure("call", "queue_full", "registration queue bound reached")
+      return success("call", { state: "queued", queued: record.queue.length })
+    }
+    if (!record.item || typeof record.item[body.method] !== "function")
+      return failure("call", "unknown_method", "loaded item does not expose the requested method")
+    try {
+      var value = record.item[body.method](payloadJson)
+      var text = value === undefined || value === null ? "ok" : String(value)
+      return success("call", { state: "delivered", value: truncate(text, limits.callValueBytes) })
+    } catch (e) {
+      record.lastError = truncate("plugin call failed", limits.diagnosticsBytes)
+      return failure("call", "plugin_call_failed", "the plugin method threw")
+    }
+  }
+
+  function dispatchHide(body) {
+    var resolved = recordFor(body.registrationId)
+    if (resolved.error) return failure("hide", resolved.error, resolved.error)
+    if (resolved.tombstone) return success("hide", { changed: false, state: "unregistered" })
+    var record = resolved.record
+    if (record.state === "registered_hidden" || record.state === "failed"
+        || record.state === "failed_collision" || record.state === "hiding")
+      return success("hide", { changed: false, state: record.state })
+    if (record.state === "unregistering")
+      return success("hide", { changed: false, state: "unregistering" })
+    record.opened = false
+    record.queue = []
+    record.generation++
+    closeItem(record)
+    var loader = record.loader
+    if (loader) {
+      record.state = "hiding"
+      loader.callbackGeneration = record.generation
+      loader.active = false
+      loader.source = ""
+      loader.destroy()
+    } else {
+      record.item = null
+      record.state = "registered_hidden"
+    }
+    return success("hide", { changed: true, state: record.state })
+  }
+
+  function dispatchUnregister(body) {
+    var resolved = recordFor(body.registrationId)
+    if (resolved.error) return failure("unregister", resolved.error, resolved.error)
+    if (resolved.tombstone) return success("unregister", { changed: false, state: "unregistered" })
+    var record = resolved.record
+    if (record.state === "unregistering")
+      return success("unregister", { changed: false, state: "unregistering" })
+    beginUnregister(record)
+    return success("unregister", { changed: true, state: "unregistering" })
+  }
+
+  function dispatchInspect(body) {
+    var resolved = recordFor(body.registrationId)
+    if (resolved.error) return failure("inspect", resolved.error, resolved.error)
+    if (resolved.tombstone) return success("inspect", { state: "unregistered" })
+    var record = resolved.record
+    var result = {
+      state: record.state,
+      pluginId: record.pluginId,
+      queued: record.queue.length
+    }
+    if (record.lastError) result.lastError = record.lastError
+    return success("inspect", result)
+  }
+
+  function request(requestJson) {
+    if (typeof requestJson !== "string") return failure("request", "bad_json", "request must be a JSON string")
+    if (utf8Bytes(requestJson) > limits.requestBytes)
+      return failure("request", "request_too_large", "request exceeds its byte bound")
+    var body
+    try { body = JSON.parse(requestJson) } catch (e) {
+      return failure("request", "bad_json", "request is not valid JSON")
+    }
+    if (!Util.isPlainObject(body)) return failure("request", "bad_json", "request must be one JSON object")
+    var operation = typeof body.operation === "string" ? truncate(body.operation, 128) : "request"
+    if (body.version !== 1) return failure(operation, "unsupported_version", "version must be exactly 1")
+    switch (operation) {
+    case "capabilities": return dispatchCapabilities()
+    case "register": return dispatchRegister(body, requestJson)
+    case "status": return dispatchStatus(body)
+    case "summon": return dispatchSummon(body)
+    case "call": return dispatchCall(body)
+    case "hide": return dispatchHide(body)
+    case "unregister": return dispatchUnregister(body)
+    case "inspect": return dispatchInspect(body)
+    default: return failure(operation, "unknown_operation", "operation is not part of v1")
+    }
+  }
+
+  function unloadAll() {
+    validationQueue = []
+    if (activeValidation) {
+      var work = activeValidation
+      activeValidation = null
+      validationSerial++
+      processWorkSerial = validationSerial
+      validationTimeout.stop()
+      validationProcess.running = false
+      if (work.kind === "register") {
+        rejectOperation(work.operationId, "source_unsafe", "shell reload cancelled validation")
+      } else {
+        failLoading(work.registrationId, work.generation, "source_unsafe", "shell reload cancelled validation")
+      }
+    }
+    for (var operationId in operations) {
+      if (operations[operationId] && operations[operationId].state === "validating")
+        rejectOperation(operationId, "source_unsafe", "shell reload cancelled validation")
+    }
+    var ids = []
+    for (var id in registrations) {
+      if (registrations[id] && registrations[id].state !== "unregistered"
+          && registrations[id].state !== "unregistering") ids.push(id)
+    }
+    for (var i = 0; i < ids.length; i++) beginUnregister(registrations[ids[i]])
+  }
+
+  function pruneTombstones() {
+    var now = Date.now()
+    var tombstones = []
+    for (var id in registrations) {
+      var record = registrations[id]
+      if (record && record.state === "unregistered") {
+        if (now > record.tombstoneExpiresAt) delete registrations[id]
+        else tombstones.push(record)
+      }
+    }
+    tombstones.sort(function(left, right) { return left.tombstoneExpiresAt - right.tombstoneExpiresAt })
+    while (tombstones.length > limits.tombstones) {
+      delete registrations[tombstones.shift().registrationId]
+    }
+  }
+
+  property Component temporaryPanelLoaderComponent: Component {
+    Loader {
+      id: panelLoader
+      property string registrationId: ""
+      property int callbackGeneration: 0
+      source: ""
+      active: false
+      asynchronous: true
+
+      onLoaded: root.handleLoaded(registrationId, callbackGeneration, panelLoader, item)
+      onItemChanged: root.handleItemChanged(registrationId, callbackGeneration, panelLoader, item)
+      onStatusChanged: {
+        if (status === Loader.Error)
+          root.handleLoadError(registrationId, callbackGeneration, panelLoader, "Loader.Error")
+      }
+      Component.onDestruction: root.handleLoaderDestroyed(
+        registrationId, callbackGeneration, panelLoader)
+    }
+  }
+}
