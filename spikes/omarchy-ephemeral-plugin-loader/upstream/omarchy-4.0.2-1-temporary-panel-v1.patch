+    + "-" + Math.random().toString(36).slice(2)
+
+  property var registrations: ({})
+  property var operations: ({})
+  property var pendingByRequest: ({})
+  property var sourceClaims: ({})
+  property var pluginIdClaims: ({})
+  property var validationQueue: []
+  property var activeValidation: null
+  property int identityCounter: 0
+  property int operationSequence: 0
+  property int validationSerial: 0
+  property int processWorkSerial: 0
+
+  readonly property var limits: ({
+    requestBytes: 32768,
+    pathBytes: 4096,
+    manifestBytes: 65536,
+    entryPointBytes: 1048576,
+    payloadBytes: 16384,
+    methodBytes: 64,
+    registrations: 16,
+    queuedCallsPerRegistration: 32,
+    queuedBytesPerRegistration: 65536,
+    identityBytes: 256,
+    diagnosticsBytes: 1024,
+    callValueBytes: 4096,
+    maxDepth: 16,
+    entryPointStringBytes: 1024,
+    manifestIdBytes: 128,
+    manifestNameBytes: 256,
+    manifestVersionBytes: 64,
+    operationRecords: 64,
+    tombstones: 64,
+    tombstoneMs: 300000
+  })
+
+  // All input paths are positional arguments. The script never interpolates
+  // caller data into shell source. It emits only bounded metadata or base64
+  // manifest content after stat and non-following path checks.
+  readonly property string sourceCheckScript:
+    "set -eu\n"
+    + "path=$1\n"
+    + "mode=$2\n"
+    + "entry=${3:-}\n"
+    + "uid=$(/usr/bin/id -u)\n"
+    + "check_components() {\n"
+    + "  local path_value=\"$1\"\n"
+    + "  local current=\"\"\n"
+    + "  local rest=\"${path_value#/}\"\n"
+    + "  while [[ -n \"$rest\" ]]; do\n"
+    + "    local part=\"${rest%%/*}\"\n"
+    + "    if [[ \"$rest\" == */* ]]; then rest=\"${rest#*/}\"; else rest=\"\"; fi\n"
+    + "    [[ -z \"$part\" ]] && continue\n"
+    + "    current=\"$current/$part\"\n"
+    + "    [[ ! -L \"$current\" ]] || exit 12\n"
+    + "  done\n"
+    + "}\n"
+    + "check_regular_owned() {\n"
+    + "  local file=\"$1\"\n"
+    + "  local max_size=\"$2\"\n"
+    + "  [[ ! -L \"$file\" ]] || exit 12\n"
+    + "  [[ -f \"$file\" ]] || exit 20\n"
+    + "  [[ \"$(stat -c '%u' -- \"$file\")\" == \"$uid\" ]] || exit 21\n"
+    + "  local mode_value=\"$(stat -c '%a' -- \"$file\")\"\n"
+    + "  local perm_tail=\"${mode_value: -2}\"\n"
+    + "  case \"$perm_tail\" in [2367]*|*[2367]) exit 22 ;; esac\n"
+    + "  (( $(stat -c '%s' -- \"$file\") <= max_size )) || exit 23\n"
+    + "}\n"
+    + "check_components \"$path\"\n"
+    + "canonical=\"$(/usr/bin/realpath -e -- \"$path\")\"\n"
+    + "[[ \"$canonical\" == \"$path\" ]] || exit 11\n"
+    + "[[ -d \"$path\" && ! -L \"$path\" ]] || exit 13\n"
+    + "[[ \"$(stat -c '%u' -- \"$path\")\" == \"$uid\" ]] || exit 14\n"
+    + "dir_mode=\"$(stat -c '%a' -- \"$path\")\"\n"
+    + "dir_perm_tail=\"${dir_mode: -2}\"\n"
+    + "case \"$dir_perm_tail\" in [2367]*|*[2367]) exit 15 ;; esac\n"
+    + "manifest=\"$path/manifest.json\"\n"
+    + "check_regular_owned \"$manifest\" 65536\n"
+    + "if [[ \"$mode\" == manifest ]]; then /usr/bin/base64 --wrap=0 -- \"$manifest\"; exit 0; fi\n"
+    + "[[ \"$mode\" == entry || \"$mode\" == load ]] || exit 24\n"
+    + "[[ -n \"$entry\" && \"$entry\" != /* && \"$entry\" != *..* ]] || exit 30\n"
+    + "entry_path=\"$path/$entry\"\n"
+    + "check_components \"$entry_path\"\n"
+    + "entry_real=\"$(/usr/bin/realpath -e -- \"$entry_path\")\"\n"
+    + "[[ \"$entry_real\" == \"$entry_path\" ]] || exit 31\n"
+    + "case \"$entry_real\" in \"$path\"/*) ;; *) exit 32 ;; esac\n"
+    + "check_regular_owned \"$entry_path\" 1048576\n"
+    + "if [[ \"$mode\" == load ]]; then /usr/bin/base64 --wrap=0 -- \"$manifest\"; else printf 'ok\\n'; fi\n"
+
